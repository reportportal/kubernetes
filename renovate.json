{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "enabledManagers": [
    "helm-values"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/^reportportal/values\\.ya?ml$/"
    ]
  },
  "labels": [
    "dependencies",
    "helm"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Do not propose updates away from mutable latest pins",
      "matchManagers": [
        "helm-values"
      ],
      "matchCurrentValue": "latest",
      "enabled": false
    },
    {
      "description": "Pinned images in reportportal/values.yaml (ReportPortal services + Helm dependency overrides)",
      "matchManagers": [
        "helm-values"
      ],
      "groupName": "ReportPortal container images",
      "schedule": [
        "before 6am on monday"
      ]
    }
  ]
}
